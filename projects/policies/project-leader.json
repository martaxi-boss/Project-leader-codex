{
  "schema_version": "1.0",
  "policy_id": "project-leader-v1",
  "project": "PROJECT LEADER",
  "repository": "martaxi-boss/Project-leader",
  "default_branch": "main",
  "effect_policies": {
    "E1_RECOVERABLE_PROJECT_LOCAL": {
      "allowed_scope_patterns": [
        "control/**",
        "tests/**",
        ".github/workflows/**",
        ".project-leader/tasks/**",
        ".project-leader/results/**",
        ".project-leader/checkpoints/**",
        ".project-leader/recovery-events/**",
        ".project-leader/transitions/**",
        "projects/**",
        "scripts/**",
        "PROJECT_LEADER.md",
        "RUNBOOK.md",
        "RECOVERY_PROTOCOL.md",
        "AGENT_BUILDER_PROMPT.md",
        "SMOKE_TESTS.md",
        "roles/**",
        "plugins/**",
        "README.md",
        "PLUGIN_SETUP.md",
        "CHANGELOG.md",
        "SOURCES.md"
      ],
      "allowed_actions": [
        "create_branch",
        "edit_project_files",
        "create_commits",
        "run_ci",
        "open_or_update_pull_request",
        "merge_development_branch"
      ],
      "required_prohibited_actions": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "license_selection",
        "managed_project_mutation",
        "production_deploy",
        "production_secret_change",
        "paid_service_activation"
      ],
      "required_ci": [
        "Control contract tests",
        "Validate control plane",
        "Package ChatGPT plugins"
      ],
      "required_validation": [
        "Mutation scope audit",
        "GitHub evidence verification"
      ],
      "required_transition_controls": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "license_selection",
        "managed_project_mutation"
      ]
    },
    "E3_DESTRUCTIVE_EXTERNAL_PRIVILEGED": {
      "allowed_scope_patterns": [
        "control/**",
        "tests/**",
        ".github/workflows/**",
        ".project-leader/tasks/**",
        ".project-leader/results/**",
        ".project-leader/recovery-events/**",
        ".project-leader/transitions/**",
        "projects/**",
        "scripts/**",
        ".agents/plugins/**",
        "PROJECT_LEADER.md",
        "RUNBOOK.md",
        "RECOVERY_PROTOCOL.md",
        "AGENT_BUILDER_PROMPT.md",
        "SMOKE_TESTS.md",
        "roles/**",
        "plugins/**",
        "README.md",
        "PLUGIN_SETUP.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "SOURCES.md",
        "LICENSE"
      ],
      "allowed_actions": [
        "create_branch",
        "edit_project_files",
        "create_commits",
        "run_ci",
        "open_or_update_pull_request",
        "merge_development_branch",
        "harden_trust_root",
        "reconcile_control_contract_docs",
        "reconcile_transition_records",
        "delete_fully_merged_non_main_branch_refs",
        "install_automatic_merged_pr_branch_hygiene",
        "delete_owner_authorized_superseded_non_main_branch_refs",
        "license_selection"
      ],
      "required_prohibited_actions": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "managed_project_mutation",
        "production_deploy",
        "production_secret_change",
        "paid_service_activation"
      ],
      "required_ci": [
        "Control contract tests",
        "Validate control plane",
        "Package ChatGPT plugins"
      ],
      "required_validation": [
        "Mutation scope audit",
        "GitHub evidence verification",
        "Trust-root governance path"
      ],
      "required_transition_controls": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "license_selection",
        "managed_project_mutation",
        "trust_root_mutation"
      ]
    }
  },
  "sensitive_paths": [
    ".github/workflows/**",
    "control/**",
    "projects/policies/**",
    "scripts/package_plugins.py",
    ".agents/plugins/**",
    "PROJECT_LEADER.md",
    "RUNBOOK.md",
    "RECOVERY_PROTOCOL.md",
    "AGENT_BUILDER_PROMPT.md",
    "roles/**",
    "plugins/**",
    ".project-leader/**",
    "projects/standing-authority.json",
    "SECURITY.md",
    "LICENSE"
  ],
  "protected_paths": [
    ".github/workflows/**",
    "control/**",
    "projects/policies/**",
    "scripts/package_plugins.py",
    ".agents/plugins/**",
    "PROJECT_LEADER.md",
    "RUNBOOK.md",
    "RECOVERY_PROTOCOL.md",
    "AGENT_BUILDER_PROMPT.md",
    "roles/**",
    "plugins/**",
    "projects/standing-authority.json",
    "SECURITY.md",
    "LICENSE"
  ]
}
