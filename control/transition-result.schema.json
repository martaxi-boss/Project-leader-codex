{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martaxi-boss/Project-leader/control/transition-result.schema.json",
  "title": "Project Leader Human-Gate Transition Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","transition_id","task_id","repository","terminal_status","authorization_record","action","target","observed_at","final_state","evidence","residual_blockers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "transition_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,159}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "terminal_status": {"enum": ["SUCCESS","FAILURE","NOT_EXECUTED","HISTORICAL_OBSERVED"]},
    "authorization_record": {"type": ["string","null"], "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","identifier"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "revision": {"type": ["string","null"], "minLength": 1},
        "base_revision": {"type": ["string","null"], "minLength": 1},
        "environment": {"type": ["string","null"], "minLength": 1}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "final_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status","revision"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "revision": {"type": ["string","null"], "minLength": 1}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "residual_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
