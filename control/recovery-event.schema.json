{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martaxi-boss/Project-leader/control/recovery-event.schema.json",
  "title": "Project Leader Append-only Recovery Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "sequence",
    "recorded_at",
    "event",
    "strategy_generation",
    "action_fingerprint",
    "attempt_count",
    "identical_failure_count",
    "no_progress_iterations",
    "previous_event_sha256",
    "detail"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "enum": [
        "FAILURE_OBSERVED",
        "RETRY_AUTHORIZED",
        "REPLAN",
        "RECOVERED",
        "BLOCKED",
        "HUMAN_GATE",
        "COMPLETE"
      ]
    },
    "strategy_generation": {
      "type": "integer",
      "minimum": 1
    },
    "action_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "identical_failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "no_progress_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "previous_event_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "detail": {
      "type": "string",
      "minLength": 1
    }
  }
}
